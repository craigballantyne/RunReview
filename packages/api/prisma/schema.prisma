generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Per-layer lifecycle for the analysis pipeline. Each layer advances independently so a failed
/// LLM call in Layer 2 doesn't discard Layer 1's deterministic output.
enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AuditAction {
  ACCOUNT_CREATED
  ACCOUNT_DELETED
  PASSWORD_UPDATED
  PASSWORD_RESET
  RUN_DATA_IMPORTED
  RUN_DATA_DELETED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique @db.Citext
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions      Session[]
  authTokens    AuthToken[]
  runs          Run[]
  importJobs    ImportJob[]
  auditLogs     AuditLog[]
  sleeps        Sleep[]
  bodyBatteries BodyBattery[]
  runInsights   RunInsight[]
  bestEfforts   RunBestEffort[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model Run {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  externalActivityId BigInt   @map("external_activity_id")
  activityName       String   @map("activity_name")
  activityType       String   @map("activity_type")
  startTimeGmt       DateTime @map("start_time_gmt") @db.Timestamptz(3)
  startTimeLocal     DateTime @map("start_time_local") @db.Timestamp(3)
  durationSec        Float    @map("duration_sec")
  movingDurationSec  Float    @map("moving_duration_sec")
  distanceM          Float    @map("distance_m")
  avgSpeedMps        Float?   @map("avg_speed_mps")
  maxSpeedMps        Float?   @map("max_speed_mps")
  avgHr              Int?     @map("avg_hr")
  maxHr              Int?     @map("max_hr")
  avgCadenceSpm      Float?   @map("avg_cadence_spm")
  maxCadenceSpm      Float?   @map("max_cadence_spm")
  elevationGainM     Float?   @map("elevation_gain_m")
  elevationLossM     Float?   @map("elevation_loss_m")
  calories           Float?
  startLatitude      Float?   @map("start_latitude")
  startLongitude     Float?   @map("start_longitude")
  location           String?
  weatherId          Int?     @map("weather_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  weather     WeatherHourly? @relation(fields: [weatherId], references: [id], onDelete: SetNull)
  splits      Split[]
  hrZones     HrZone[]
  trackPoints TrackPoint[]
  insight     RunInsight?
  bestEfforts RunBestEffort[]

  @@unique([userId, externalActivityId])
  @@index([userId, startTimeGmt])
  @@index([weatherId])
  @@map("runs")
}

model Split {
  id             String   @id @default(uuid())
  runId          String   @map("run_id")
  splitIndex     Int      @map("split_index")
  startTimeGmt   DateTime @map("start_time_gmt") @db.Timestamptz(3)
  distanceM      Float    @map("distance_m")
  durationSec    Float    @map("duration_sec")
  avgSpeedMps    Float?   @map("avg_speed_mps")
  avgHr          Int?     @map("avg_hr")
  maxHr          Int?     @map("max_hr")
  avgCadenceSpm  Float?   @map("avg_cadence_spm")
  elevationGainM Float?   @map("elevation_gain_m")
  elevationLossM Float?   @map("elevation_loss_m")

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, splitIndex])
  @@map("splits")
}

model HrZone {
  id            String @id @default(uuid())
  runId         String @map("run_id")
  zoneNumber    Int    @map("zone_number")
  zoneLowBpm    Int?   @map("zone_low_bpm")
  zoneHighBpm   Int?   @map("zone_high_bpm")
  secondsInZone Float  @map("seconds_in_zone")

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, zoneNumber])
  @@map("hr_zones")
}

model TrackPoint {
  id         BigInt @id @default(autoincrement())
  runId      String @map("run_id")
  pointIndex Int    @map("point_index")
  elapsedSec Float  @map("elapsed_sec")
  latitude   Float?
  longitude  Float?
  elevationM Float? @map("elevation_m")
  heartRate  Int?   @map("heart_rate")
  speedMps   Float? @map("speed_mps")

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, pointIndex])
  @@index([runId])
  @@map("track_points")
}

/// Analysis output, 1:1 with a run. Cascade-deleted with the run, matching every other run-scoped
/// table.
///
/// The classification columns are `String`, not Postgres enums, even though this schema uses
/// Prisma enums elsewhere. The vocabulary here is expected to churn while the pipeline is tuned,
/// and altering a Postgres enum needs a migration for every added value; the authoritative
/// definitions are the union types in `@run-review/shared`, so enums would also be a second copy
/// free to drift. `AnalysisStatus` stays an enum because a lifecycle is genuinely stable.
model RunInsight {
  id    String @id @default(uuid())
  runId String @unique @map("run_id")

  /// Denormalized from the run, like `audit_logs.user_email`. Layer 3's comparable-run lookup
  /// filters by user + classification on every single analysed run, and carrying the user here
  /// keeps that a single index scan instead of a join.
  userId String @map("user_id")

  // --- Layer 1: deterministic, no LLM ---
  layer1Status     AnalysisStatus @default(PENDING) @map("layer1_status")
  layer1Version    Int?           @map("layer1_version")
  layer1ComputedAt DateTime?      @map("layer1_computed_at")
  layer1Error      String?        @map("layer1_error")

  lapMode            String?  @map("lap_mode")
  lapModeSource      String?  @map("lap_mode_source")
  runTypeByDistance  String?  @map("run_type_by_distance")
  hrZone             String?  @map("hr_zone")
  hrZoneDistribution Json?    @map("hr_zone_distribution")
  splitPattern       String?  @map("split_pattern")
  elevationBucket    String?  @map("elevation_bucket")
  /// Recomputed from smoothed track elevation, not the device's own gain total.
  elevationGainM     Float?   @map("elevation_gain_m")
  tempBucket         String?  @map("temp_bucket")
  humidityFlag       Boolean? @map("humidity_flag")
  windFlag           Boolean? @map("wind_flag")
  heatStress         String?  @map("heat_stress")
  segmentRoles       Json?    @map("segment_roles")
  rawPointFlags      Json?    @map("raw_point_flags")

  // --- Layer 2: intent parsing + flag adjudication ---
  layer2Status     AnalysisStatus @default(PENDING) @map("layer2_status")
  layer2Version    Int?           @map("layer2_version")
  layer2ComputedAt DateTime?      @map("layer2_computed_at")
  layer2Error      String?        @map("layer2_error")

  workoutStructure         String?  @map("workout_structure")
  warmupCooldownDetected   Boolean? @map("warmup_cooldown_detected")
  walkBreakPattern         Boolean? @map("walk_break_pattern")
  effortPaceMismatch       String?  @map("effort_pace_mismatch")
  fadeDetected             Boolean? @map("fade_detected")
  surgePattern             Boolean? @map("surge_pattern")
  evenEffortDespiteTerrain Boolean? @map("even_effort_despite_terrain")
  /// Workout intent parsed from the activity title. Null when the title carries none — titles are
  /// inconsistent, and an absent intent must stay absent rather than being guessed.
  parsedIntent             Json?    @map("parsed_intent")

  // --- Layer 3: narrative synthesis ---
  layer3Status     AnalysisStatus @default(PENDING) @map("layer3_status")
  layer3Version    Int?           @map("layer3_version")
  layer3ComputedAt DateTime?      @map("layer3_computed_at")
  layer3Error      String?        @map("layer3_error")
  /// Conditionally-present prose fields; the schema omits what isn't warranted for a given run.
  narrative        Json?          @map("narrative")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  run  Run  @relation(fields: [runId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Serves Layer 3's "comparable runs" lookup: same athlete, same session type, same distance band.
  @@index([userId, workoutStructure, runTypeByDistance])
  @@index([layer1Status])
  @@index([layer2Status])
  @@index([layer3Status])
  @@map("run_insights")
}

/// Fastest standard-distance efforts found within a run. Stored whether or not they were a PR —
/// "21:30 against your 20:45 best" is the baseline material Layer 3 needs, and it only exists if
/// non-PR efforts are kept.
model RunBestEffort {
  id     String @id @default(uuid())
  runId  String @map("run_id")
  /// Denormalized alongside `startTimeGmt` so the point-in-time "best before this date" lookup is
  /// an index scan rather than a join back through runs.
  userId String @map("user_id")

  distanceM    Int      @map("distance_m")
  durationSec  Float    @map("duration_sec")
  /// Where the effort began, in metres from the start of the run.
  startOffsetM Float    @map("start_offset_m")
  /// True when this beat everything the athlete had done *before* this run — a point-in-time fact,
  /// never recomputed against later history.
  isPr         Boolean  @default(false) @map("is_pr")
  startTimeGmt DateTime @map("start_time_gmt") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at")

  run  Run  @relation(fields: [runId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([runId, distanceM])
  @@index([userId, distanceM, startTimeGmt])
  @@map("run_best_efforts")
}

model Sleep {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  day                 DateTime @db.Date
  sleepTimeSec        Int?     @map("sleep_time_sec")
  napTimeSec          Int?     @map("nap_time_sec")
  deepSleepSec        Int?     @map("deep_sleep_sec")
  lightSleepSec       Int?     @map("light_sleep_sec")
  remSleepSec         Int?     @map("rem_sleep_sec")
  awakeSleepSec       Int?     @map("awake_sleep_sec")
  sleepStartGmt       DateTime @map("sleep_start_gmt") @db.Timestamptz(3)
  sleepEndGmt         DateTime @map("sleep_end_gmt") @db.Timestamptz(3)
  sleepStartLocal     DateTime @map("sleep_start_local") @db.Timestamp(3)
  sleepEndLocal       DateTime @map("sleep_end_local") @db.Timestamp(3)
  sleepScore          Int?     @map("sleep_score")
  sleepScoreQualifier String?  @map("sleep_score_qualifier")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@map("sleep")
}

model BodyBattery {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  day                 DateTime @db.Date
  charged             Int?
  drained             Int?
  startTimestampGmt   DateTime @map("start_timestamp_gmt") @db.Timestamptz(3)
  endTimestampGmt     DateTime @map("end_timestamp_gmt") @db.Timestamptz(3)
  startTimestampLocal DateTime @map("start_timestamp_local") @db.Timestamp(3)
  endTimestampLocal   DateTime @map("end_timestamp_local") @db.Timestamp(3)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  readings BodyBatteryReading[]

  @@unique([userId, day])
  @@map("body_battery")
}

model BodyBatteryReading {
  id            String   @id @default(uuid())
  bodyBatteryId String   @map("body_battery_id")
  readingIndex  Int      @map("reading_index")
  timestampGmt  DateTime @map("timestamp_gmt") @db.Timestamptz(3)
  batteryLevel  Int      @map("battery_level")

  bodyBattery BodyBattery @relation(fields: [bodyBatteryId], references: [id], onDelete: Cascade)

  @@unique([bodyBatteryId, readingIndex])
  @@map("body_battery_readings")
}

model ImportJob {
  id                  String          @id @default(uuid())
  userId              String          @map("user_id")
  status              ImportJobStatus @default(PENDING)
  fileName            String          @map("file_name")
  fileSizeBytes       BigInt?         @map("file_size_bytes")
  totalActivities     Int?            @map("total_activities")
  processedActivities Int             @default(0) @map("processed_activities")
  importedCount       Int             @default(0) @map("imported_count")
  skippedCount        Int             @default(0) @map("skipped_count")
  skippedDetails      Json?           @map("skipped_details")
  errorMessage        String?         @map("error_message")
  createdAt           DateTime        @default(now()) @map("created_at")
  startedAt           DateTime?       @map("started_at")
  completedAt         DateTime?       @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("import_jobs")
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?     @map("user_id")
  userEmail String      @map("user_email")
  action    AuditAction
  metadata  Json?
  createdAt DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model GeocodeCache {
  id         Int      @id @default(autoincrement())
  latRounded Float    @map("lat_rounded")
  lonRounded Float    @map("lon_rounded")
  location   String
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([latRounded, lonRounded])
  @@map("geocode_cache")
}

model WeatherHourly {
  id                   Int      @id @default(autoincrement())
  latRounded           Float    @map("lat_rounded")
  lonRounded           Float    @map("lon_rounded")
  timestampUtc         DateTime @map("timestamp_utc") @db.Timestamptz(3)
  temperatureC         Float?   @map("temperature_c")
  apparentTemperatureC Float?   @map("apparent_temperature_c")
  relativeHumidityPct  Int?     @map("relative_humidity_pct")
  precipitationMm      Float?   @map("precipitation_mm")
  weatherCode          Int?     @map("weather_code")
  cloudCoverPct        Int?     @map("cloud_cover_pct")
  windSpeedMps         Float?   @map("wind_speed_mps")
  windDirectionDeg     Int?     @map("wind_direction_deg")
  windGustsMps         Float?   @map("wind_gusts_mps")
  createdAt            DateTime @default(now()) @map("created_at")

  runs Run[]

  @@unique([latRounded, lonRounded, timestampUtc])
  @@map("weather_hourly")
}
