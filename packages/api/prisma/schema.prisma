generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AuditAction {
  ACCOUNT_CREATED
  ACCOUNT_DELETED
  PASSWORD_UPDATED
  PASSWORD_RESET
  RUN_DATA_IMPORTED
  RUN_DATA_DELETED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique @db.Citext
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions      Session[]
  authTokens    AuthToken[]
  runs          Run[]
  importJobs    ImportJob[]
  auditLogs     AuditLog[]
  sleeps        Sleep[]
  bodyBatteries BodyBattery[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model Run {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  externalActivityId BigInt   @map("external_activity_id")
  activityName       String   @map("activity_name")
  activityType       String   @map("activity_type")
  startTimeGmt       DateTime @map("start_time_gmt") @db.Timestamptz(3)
  startTimeLocal     DateTime @map("start_time_local") @db.Timestamp(3)
  durationSec        Float    @map("duration_sec")
  movingDurationSec  Float    @map("moving_duration_sec")
  distanceM          Float    @map("distance_m")
  avgSpeedMps        Float?   @map("avg_speed_mps")
  maxSpeedMps        Float?   @map("max_speed_mps")
  avgHr              Int?     @map("avg_hr")
  maxHr              Int?     @map("max_hr")
  avgCadenceSpm      Float?   @map("avg_cadence_spm")
  maxCadenceSpm      Float?   @map("max_cadence_spm")
  elevationGainM     Float?   @map("elevation_gain_m")
  elevationLossM     Float?   @map("elevation_loss_m")
  calories           Float?
  startLatitude      Float?   @map("start_latitude")
  startLongitude     Float?   @map("start_longitude")
  location           String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  splits      Split[]
  hrZones     HrZone[]
  trackPoints TrackPoint[]

  @@unique([userId, externalActivityId])
  @@index([userId, startTimeGmt])
  @@map("runs")
}

model Split {
  id             String   @id @default(uuid())
  runId          String   @map("run_id")
  splitIndex     Int      @map("split_index")
  startTimeGmt   DateTime @map("start_time_gmt") @db.Timestamptz(3)
  distanceM      Float    @map("distance_m")
  durationSec    Float    @map("duration_sec")
  avgSpeedMps    Float?   @map("avg_speed_mps")
  avgHr          Int?     @map("avg_hr")
  maxHr          Int?     @map("max_hr")
  avgCadenceSpm  Float?   @map("avg_cadence_spm")
  elevationGainM Float?   @map("elevation_gain_m")
  elevationLossM Float?   @map("elevation_loss_m")

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, splitIndex])
  @@map("splits")
}

model HrZone {
  id            String @id @default(uuid())
  runId         String @map("run_id")
  zoneNumber    Int    @map("zone_number")
  zoneLowBpm    Int?   @map("zone_low_bpm")
  zoneHighBpm   Int?   @map("zone_high_bpm")
  secondsInZone Float  @map("seconds_in_zone")

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, zoneNumber])
  @@map("hr_zones")
}

model TrackPoint {
  id         BigInt @id @default(autoincrement())
  runId      String @map("run_id")
  pointIndex Int    @map("point_index")
  elapsedSec Float  @map("elapsed_sec")
  latitude   Float?
  longitude  Float?
  elevationM Float? @map("elevation_m")
  heartRate  Int?   @map("heart_rate")
  speedMps   Float? @map("speed_mps")

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, pointIndex])
  @@index([runId])
  @@map("track_points")
}

model Sleep {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  day                 DateTime @db.Date
  sleepTimeSec        Int?     @map("sleep_time_sec")
  napTimeSec          Int?     @map("nap_time_sec")
  deepSleepSec        Int?     @map("deep_sleep_sec")
  lightSleepSec       Int?     @map("light_sleep_sec")
  remSleepSec         Int?     @map("rem_sleep_sec")
  awakeSleepSec       Int?     @map("awake_sleep_sec")
  sleepStartGmt       DateTime @map("sleep_start_gmt") @db.Timestamptz(3)
  sleepEndGmt         DateTime @map("sleep_end_gmt") @db.Timestamptz(3)
  sleepStartLocal     DateTime @map("sleep_start_local") @db.Timestamp(3)
  sleepEndLocal       DateTime @map("sleep_end_local") @db.Timestamp(3)
  sleepScore          Int?     @map("sleep_score")
  sleepScoreQualifier String?  @map("sleep_score_qualifier")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@map("sleep")
}

model BodyBattery {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  day                 DateTime @db.Date
  charged             Int?
  drained             Int?
  startTimestampGmt   DateTime @map("start_timestamp_gmt") @db.Timestamptz(3)
  endTimestampGmt     DateTime @map("end_timestamp_gmt") @db.Timestamptz(3)
  startTimestampLocal DateTime @map("start_timestamp_local") @db.Timestamp(3)
  endTimestampLocal   DateTime @map("end_timestamp_local") @db.Timestamp(3)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  readings BodyBatteryReading[]

  @@unique([userId, day])
  @@map("body_battery")
}

model BodyBatteryReading {
  id            String   @id @default(uuid())
  bodyBatteryId String   @map("body_battery_id")
  readingIndex  Int      @map("reading_index")
  timestampGmt  DateTime @map("timestamp_gmt") @db.Timestamptz(3)
  batteryLevel  Int      @map("battery_level")

  bodyBattery BodyBattery @relation(fields: [bodyBatteryId], references: [id], onDelete: Cascade)

  @@unique([bodyBatteryId, readingIndex])
  @@map("body_battery_readings")
}

model ImportJob {
  id                  String          @id @default(uuid())
  userId              String          @map("user_id")
  status              ImportJobStatus @default(PENDING)
  fileName            String          @map("file_name")
  fileSizeBytes       BigInt?         @map("file_size_bytes")
  totalActivities     Int?            @map("total_activities")
  processedActivities Int             @default(0) @map("processed_activities")
  importedCount       Int             @default(0) @map("imported_count")
  skippedCount        Int             @default(0) @map("skipped_count")
  skippedDetails      Json?           @map("skipped_details")
  errorMessage        String?         @map("error_message")
  createdAt           DateTime        @default(now()) @map("created_at")
  startedAt           DateTime?       @map("started_at")
  completedAt         DateTime?       @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("import_jobs")
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?     @map("user_id")
  userEmail String      @map("user_email")
  action    AuditAction
  metadata  Json?
  createdAt DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model GeocodeCache {
  id         Int      @id @default(autoincrement())
  latRounded Float    @map("lat_rounded")
  lonRounded Float    @map("lon_rounded")
  location   String
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([latRounded, lonRounded])
  @@map("geocode_cache")
}
