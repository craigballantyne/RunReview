# Postgres
POSTGRES_USER=runreview
POSTGRES_PASSWORD=change-me
POSTGRES_DB=runreview
DATABASE_URL=postgresql://runreview:change-me@postgres:5432/runreview

# Redis
REDIS_URL=redis://redis:6379

# Sessions
SESSION_COOKIE_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=rr_session

# Email (Resend)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="Run Review <noreply@runreview.app>"

# App
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000
NODE_ENV=development

# Feature flags
# When false, new signups are auto-verified and skip the email verification loop entirely.
# Useful in dev/test where Resend delivery is often unconfigured or inconvenient to check.
FEATURE_EMAIL_VERIFICATION=true

# Reverse geocoding (Nominatim usage policy requires a descriptive UA with contact info)
NOMINATIM_USER_AGENT="RunReview/0.1 (contact: you@example.com)"

# Route planner (OpenRouteService — get a free key at https://openrouteservice.org/dev/#/signup)
OPENROUTESERVICE_API_KEY=your_ors_api_key_here

# Import uploads
IMPORT_UPLOAD_DIR=/data/imports
IMPORT_MAX_FILE_SIZE_BYTES=268435456
