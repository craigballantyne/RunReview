{
  "name": "run-review",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev --workspace packages/api",
    "dev:worker": "npm run dev:worker --workspace packages/api",
    "dev:web": "npm run dev --workspace packages/web",
    "prisma:migrate": "npm run prisma:migrate --workspace packages/api",
    "prisma:generate": "npm run prisma:generate --workspace packages/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
